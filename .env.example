# NanoClaw configuration. Copy to `.env` and fill in as needed.

# Claude auth — set ONE of these (see README "Claude Authentication").
# CLAUDE_CODE_OAUTH_TOKEN=...      # Claude Pro/Max subscription token
# ANTHROPIC_API_KEY=...            # Anthropic API key

# Assistant name (default: Andy)
# ASSISTANT_NAME=Andy

# Container runtime: auto (default) | docker | podman | container | host
# `host` runs agents directly on the host with NO container/sandbox — required
# to run on Windows without Docker/WSL2. Build the agent-runner first with
# `npm run build:agent`. See README "Run on Windows without Docker (host mode)".
# CONTAINER_RUNTIME=host
